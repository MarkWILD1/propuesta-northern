generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  passwordPlain String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LandingPage {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique @default("home")
  title                 String
  eyebrow               String
  heroTitle             String
  heroSubtitle          String
  ctaLabel              String
  ctaHref               String
  levelsTitle           String                 @default("Propuesta educativa")
  statsTitle            String                 @default("Nuestra comunidad en numeros")
  featuredTitle         String                 @default("Lo que nos define")
  activitiesTitle       String                 @default("Vida en el colegio")
  activitiesKicker      String                 @default("Vida escolar")
  galleryTitle          String                 @default("Momentos de la comunidad Northern")
  newsTitle             String                 @default("Noticias")
  instagramTitle        String                 @default("Seguinos en Instagram")
  instagramUrl          String                 @default("")
  contactTitle          String
  contactBody           String
  contactEmail          String
  contactPhone          String?
  published             Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sections              LandingSection[]
  workshops             Workshop[]
  carouselSlides        CarouselSlide[]
  navLinks              NavLink[]
  programLevels         ProgramLevel[]
  stats                 StatItem[]
  activities            ActivityTab[]
  news                  NewsItem[]
  instagramPosts        InstagramPost[]
  locations             Location[]
  physicalEducation     PhysicalEducation?
  multidisciplinaryTeam MultidisciplinaryTeam?
  institutionalProject  InstitutionalProject?
  finalShow             FinalShow?
  announcementBar       AnnouncementBar?
  contentPages          ContentPage[]
}

model LandingSection {
  id            String      @id @default(cuid())
  landingPageId String
  title         String
  body          String
  ctaLabel      String?
  ctaHref       String?
  sortOrder     Int
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, sortOrder])
}

model Workshop {
  id            String      @id @default(cuid())
  landingPageId String
  title         String
  body          String      @default("")
  altText       String
  caption       String?
  driveUrl      String
  driveFileId   String
  href          String?
  sortOrder     Int
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, sortOrder])
  @@map("Photo")
}

model CarouselSlide {
  id            String      @id @default(cuid())
  landingPageId String
  title         String
  altText       String
  caption       String?
  driveUrl      String
  driveFileId   String
  sortOrder     Int
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, sortOrder])
}

model NavLink {
  id            String      @id @default(cuid())
  landingPageId String
  label         String
  href          String
  linkType      String      @default("SECTION")
  openInNewTab  Boolean     @default(false)
  highlight     Boolean     @default(false)
  sortOrder     Int
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, sortOrder])
}

model ProgramLevel {
  id            String      @id @default(cuid())
  landingPageId String
  title         String
  slug          String
  body          String
  detailBody    String
  altText       String
  driveUrl      String
  driveFileId   String
  ctaLabel      String?
  ctaHref       String?
  sortOrder     Int
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, slug])
  @@index([landingPageId, sortOrder])
}

model StatItem {
  id            String      @id @default(cuid())
  landingPageId String
  label         String
  value         String
  sortOrder     Int
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, sortOrder])
}

model ActivityTab {
  id            String      @id @default(cuid())
  landingPageId String
  title         String
  body          String
  altText       String?
  driveUrl      String?
  driveFileId   String?
  ctaLabel      String?
  ctaHref       String?
  sortOrder     Int
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, sortOrder])
}

model NewsItem {
  id            String      @id @default(cuid())
  landingPageId String
  title         String
  excerpt       String
  dateLabel     String?
  altText       String?
  driveUrl      String?
  driveFileId   String?
  href          String?
  sortOrder     Int
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, sortOrder])
}

model InstagramPost {
  id            String      @id @default(cuid())
  landingPageId String
  caption       String?
  altText       String      @default("")
  driveUrl      String?
  driveFileId   String?
  href          String
  sortOrder     Int
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, sortOrder])
}

model Location {
  id            String      @id @default(cuid())
  landingPageId String
  name          String
  addressLines  String
  phone         String?
  body          String      @default("")
  altText       String      @default("")
  driveUrl      String?
  driveFileId   String?
  href          String?
  sortOrder     Int
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, sortOrder])
}

model PhysicalEducation {
  id            String      @id @default(cuid())
  landingPageId String      @unique
  title         String
  body          String
  altText       String      @default("")
  driveUrl      String?
  driveFileId   String?
  ctaLabel      String?
  ctaHref       String?
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
}

model MultidisciplinaryTeam {
  id            String      @id @default(cuid())
  landingPageId String      @unique
  title         String
  body          String
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  videos        TeamVideo[]
}

model TeamVideo {
  id                      String                @id @default(cuid())
  multidisciplinaryTeamId String
  url                     String
  sortOrder               Int
  published               Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  multidisciplinaryTeam   MultidisciplinaryTeam @relation(fields: [multidisciplinaryTeamId], references: [id], onDelete: Cascade)

  @@index([multidisciplinaryTeamId, sortOrder])
}

model InstitutionalProject {
  id            String      @id @default(cuid())
  landingPageId String      @unique
  title         String
  body          String
  altText       String      @default("")
  driveUrl      String?
  driveFileId   String?
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
}

model FinalShow {
  id            String      @id @default(cuid())
  landingPageId String      @unique
  title         String
  body          String
  eventAt       DateTime?
  videoUrl      String?
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
}

model AnnouncementBar {
  id            String      @id @default(cuid())
  landingPageId String      @unique
  message       String
  linkLabel     String?
  linkType      String      @default("NONE")
  href          String?
  openInNewTab  Boolean     @default(false)
  dismissible   Boolean     @default(true)
  published     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
}

model ContentPage {
  id            String      @id @default(cuid())
  landingPageId String
  title         String
  slug          String
  body          String
  altText       String      @default("")
  driveUrl      String?
  driveFileId   String?
  sortOrder     Int         @default(0)
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, slug])
  @@index([landingPageId, sortOrder])
}
